GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL='models/embedding-001'
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
OPENAI_CHAT_MODEL='gpt-5-nano'
# O sufixo +psycopg é obrigatório: langchain-postgres usa SQLAlchemy com psycopg 3.
# A porta 55432 é a exposta no host pelo docker-compose.yml (5432 é a interna do container).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/rag
PG_VECTOR_COLLECTION_NAME=desafio_rag
PDF_PATH=./document.pdf
